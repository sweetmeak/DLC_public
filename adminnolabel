<?php
declare(strict_types=1);

require_once __DIR__ . '/../app/bootstrap.php';
require_once __DIR__ . '/../app/vk_stats.php';
require_once __DIR__ . '/../app/nolabel.php';

require_role(['admin']);
$pdo = db();

if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    verify_csrf();
    $action = (string)($_POST['action'] ?? 'add');

    if ($action === 'delete') {
        $id = (int)($_POST['id'] ?? 0);
        if ($id > 0) {
            $q = $pdo->prepare('DELETE FROM nolabel_releases WHERE id = ?');
            $q->execute([$id]);
            flash('success', 'NoLabel-релиз удалён из чарта.');
        }
        go('admin-nolabel.php');
    }

    $url = trim((string)($_POST['playlist_url'] ?? ''));
    if (!vk_playlist_url_is_valid($url)) {
        flash('error', 'Укажите корректную публичную ссылку на плейлист VK.');
        go('admin-nolabel.php');
    }

    $meta = nolabel_vk_playlist_metadata($url);
    if (empty($meta['ok'])) {
        $message = (string)($meta['error'] ?? 'Не удалось прочитать данные плейлиста.');
        $d = is_array($meta['diagnostics'] ?? null) ? $meta['diagnostics'] : [];
        if ($d) {
            $sections = [];
            foreach (($d['section_attempts'] ?? []) as $a) {
                $sections[] = ($a['host'] ?? '?') . ': HTTP ' . ($a['http'] ?? 0) . ', bytes ' . ($a['bytes'] ?? 0) . ', author blocks ' . ($a['author_blocks'] ?? 0) . ', links ' . ($a['artist_links'] ?? 0);
            }
            $message .= ' | Диагностика: cURL=' . (!empty($d['curl']) ? 'да' : 'нет')
                . ', DOM=' . (!empty($d['dom']) ? 'да' : 'нет')
                . ', страница HTTP=' . ($d['page_http'] ?? 0)
                . ', размер=' . ($d['page_bytes'] ?? 0) . ' байт'
                . ', заголовок=' . (!empty($d['title_found']) ? 'найден' : 'нет')
                . ', блоков артистов=' . ($d['initial_author_blocks'] ?? 0)
                . ', ссылок артистов=' . ($d['initial_artist_links'] ?? 0)
                . ', JSON совпадений=' . ($d['json_artist_matches'] ?? 0)
                . ', legacy аудио=' . ($d['legacy_audio_rows'] ?? 0)
                . ', артистов итог=' . ($d['artists_found'] ?? 0);
            if ($sections) $message .= ' | load_section: ' . implode(' ; ', $sections);
        }
        flash('error', $message);
        go('admin-nolabel.php');
    }
    $stats = vk_fetch_playlist_plays($url);
    $statsOk = !empty($stats['ok']);
    $plays = $statsOk ? max(0, (int)$stats['plays']) : 0;
    $statsError = $statsOk ? null : substr((string)($stats['error'] ?? 'Счётчик VK пока недоступен.'), 0, 500);

    $user = current_user();
    $artistsJson = json_encode($meta['artists'], JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES);
    $pdo->beginTransaction();
    try {
        $q = $pdo->prepare(
            'INSERT INTO nolabel_releases
                (playlist_url, vk_owner_id, vk_playlist_id, title, artist_names_json,
                 cover_url, total_plays, last_checked_at, last_success_at, last_error, created_by)
             VALUES (?, ?, ?, ?, ?, ?, ?, IF(? = 1, NOW(), NULL), IF(? = 1, NOW(), NULL), ?, ?)
             ON DUPLICATE KEY UPDATE
                vk_owner_id = VALUES(vk_owner_id),
                vk_playlist_id = VALUES(vk_playlist_id),
                title = VALUES(title),
                artist_names_json = VALUES(artist_names_json),
                cover_url = VALUES(cover_url),
                total_plays = IF(VALUES(last_success_at) IS NULL, nolabel_releases.total_plays, VALUES(total_plays)),
                last_checked_at = IF(VALUES(last_success_at) IS NULL, nolabel_releases.last_checked_at, NOW()),
                last_success_at = IF(VALUES(last_success_at) IS NULL, nolabel_releases.last_success_at, NOW()),
                last_error = VALUES(last_error)'
        );
        $q->execute([
            $url, $meta['owner_id'], $meta['playlist_id'], $meta['title'],
            $artistsJson, $meta['cover_url'] ?: null, $plays,
            $statsOk ? 1 : 0, $statsOk ? 1 : 0, $statsError, (int)$user['id']
        ]);
        $find = $pdo->prepare('SELECT id FROM nolabel_releases WHERE playlist_url = ?');
        $find->execute([$url]);
        $id = (int)$find->fetchColumn();
        $snapshot = $pdo->prepare('INSERT INTO nolabel_release_snapshots (nolabel_release_id, total_plays, captured_at) VALUES (?, ?, NOW())');
        $snapshot->execute([$id, $plays]);
        $pdo->commit();
        flash(
            $statsOk ? 'success' : 'error',
            $statsOk
                ? 'Плейлист добавлен в чарт NoLabel: ' . number_format($plays, 0, ',', ' ') . ' прослушиваний.'
                : 'Плейлист добавлен в чарт NoLabel, но счётчик VK пока не прочитан. Автоматическая проверка повторится при следующем обновлении: ' . $statsError
        );
    } catch (Throwable $e) {
        if ($pdo->inTransaction()) $pdo->rollBack();
        error_log('NoLabel playlist save: ' . $e->getMessage());
        flash('error', 'Не удалось сохранить NoLabel-релиз. Проверьте миграцию базы данных.');
    }
    go('admin-nolabel.php');
}

$items = $pdo->query('SELECT * FROM nolabel_releases ORDER BY created_at DESC, id DESC')->fetchAll(PDO::FETCH_ASSOC);
$pageTitle = 'NoLabel релиз';
page_start($pageTitle);
