<?php
declare(strict_types=1);

require_once __DIR__ . '/../app/bootstrap.php';
require_once __DIR__ . '/../app/release_artists.php';

$pdo = db();
date_default_timezone_set('Europe/Moscow');

// Текущий пользователь. Для гостей ID будет равен 0.
$currentUser = current_user();
$currentUserId = (int)($currentUser['id'] ?? $currentUser['user_id'] ?? 0);

$period = (string)($_GET['period'] ?? '7');

if (!in_array($period, ['7', '30', 'all'], true)) {
    $period = '7';
}

$today = new DateTimeImmutable('today');
$days = $period === '30' ? 30 : 7;

if ($period !== 'all') {
    $currentStart = $today->modify('-' . ($days - 1) . ' days')->format('Y-m-d');
    $previousStart = $today->modify('-' . (($days * 2) - 1) . ' days')->format('Y-m-d');
    $previousEnd = $today->modify('-' . $days . ' days')->format('Y-m-d');
} else {
    $currentStart = $previousStart = $previousEnd = '';
}

/*
 * Получаем релизы, для которых подключена статистика VK.
 * user_id нужен для определения релизов текущего пользователя.
 */
$sql = "
    SELECT
        r.id,
        r.user_id,
        r.title,
        r.main_artist,
        r.metadata_json,
        r.cover_path,
        s.playlist_url,
        s.last_total_plays
    FROM releases r
    INNER JOIN release_stats_sources s ON s.release_id = r.id
    WHERE r.status = 'loaded'
    ORDER BY r.id DESC
    LIMIT 500
";

$releases = $pdo->query($sql)->fetchAll();

// Подтягиваем участников с ролью feat. из метаданных каждого трека.
$artistTracks = [];
if ($releases) {
    $releaseIds = array_values(array_unique(array_map(static fn($row) => (int)$row['id'], $releases)));
    $marks = implode(',', array_fill(0, count($releaseIds), '?'));
    $trackStmt = $pdo->prepare("SELECT release_id, track_json FROM release_tracks WHERE release_id IN ($marks) ORDER BY release_id, track_no");
    $trackStmt->execute($releaseIds);
    foreach ($trackStmt->fetchAll(PDO::FETCH_ASSOC) as $trackRow) {
        $artistTracks[(int)$trackRow['release_id']][] = $trackRow;
    }
}

$daily = [];

if ($period !== 'all' && $releases) {
    $dailySql = "
        SELECT release_id, stat_date, chart_plays, captured_at
        FROM release_stats_daily_snapshots
        WHERE stat_date >= :start_date
          AND stat_date <= :end_date
        ORDER BY release_id, stat_date, captured_at
    ";

    $stmt = $pdo->prepare($dailySql);

    $stmt->execute([
        ':start_date' => $previousStart,
        ':end_date' => $today->format('Y-m-d'),
    ]);

    foreach ($stmt->fetchAll() as $row) {
        $rid = (int)$row['release_id'];
        $date = (string)$row['stat_date'];
        $daily[$rid][$date] = (int)$row['chart_plays'];
    }
}

/*
 * Последние значения общего счётчика VK.
 */
$allTime = [];

if ($releases) {
    $snapshotSql = "
        SELECT s1.release_id, s1.total_plays, s1.captured_at
        FROM release_stats_snapshots s1
        INNER JOIN (
            SELECT release_id, MAX(captured_at) AS latest_at
            FROM release_stats_snapshots
            GROUP BY release_id
        ) latest
            ON latest.release_id = s1.release_id
           AND latest.latest_at = s1.captured_at
    ";

    foreach ($pdo->query($snapshotSql)->fetchAll() as $row) {
        $rid = (int)$row['release_id'];

        $allTime[$rid] = [
            'total' => (int)$row['total_plays'],
            'captured_at' => (string)$row['captured_at'],
        ];
    }
}

/*
 * Предыдущее значение общего счётчика.
 */
$previousAllTime = [];

if ($period === 'all' && $releases) {
    $previousSql = "
        SELECT current_row.release_id, previous_row.total_plays
        FROM release_stats_snapshots current_row
        INNER JOIN (
            SELECT release_id, MAX(captured_at) AS latest_at
            FROM release_stats_snapshots
            GROUP BY release_id
        ) latest
            ON latest.release_id = current_row.release_id
           AND latest.latest_at = current_row.captured_at
        LEFT JOIN release_stats_snapshots previous_row
            ON previous_row.release_id = current_row.release_id
           AND previous_row.captured_at < current_row.captured_at
           AND previous_row.captured_at = (
                SELECT MAX(p2.captured_at)
                FROM release_stats_snapshots p2
                WHERE p2.release_id = current_row.release_id
                  AND p2.captured_at < current_row.captured_at
           )
    ";

    foreach ($pdo->query($previousSql)->fetchAll() as $row) {
        if ($row['total_plays'] !== null) {
            $previousAllTime[(int)$row['release_id']] = (int)$row['total_plays'];
        }
    }
}

/*
 * Формируем рейтинг.
 */
$chart = [];

foreach ($releases as $release) {
    $id = (int)$release['id'];

    $total = $allTime[$id]['total']
        ?? (int)($release['last_total_plays'] ?? 0);

    if ($period === 'all') {
        $plays = $total;
        $previous = $previousAllTime[$id] ?? null;
    } else {
        $plays = 0;
        $previous = 0;

        foreach (($daily[$id] ?? []) as $date => $value) {
            if ($date >= $currentStart && $date <= $today->format('Y-m-d')) {
                $plays += $value;
            } elseif ($date >= $previousStart && $date <= $previousEnd) {
                $previous += $value;
            }
        }

        if ($previous === 0) {
            $previous = null;
        }
    }

    $growth = null;

    if ($previous !== null && $previous > 0) {
        $growth = (($plays - $previous) / $previous) * 100;
    }

    $metadata = json_decode((string)($release['metadata_json'] ?? '{}'), true) ?: [];
    $release['artist_display'] = pmd_release_artist_display(
        $metadata,
        $artistTracks[$id] ?? []
    );

    $release['chart_plays'] = $plays;
    $release['growth'] = $growth;
    $release['all_time_plays'] = $total;

    // Отмечаем релизы, принадлежащие текущему пользователю.
    $release['is_own'] = (
        $currentUserId > 0 &&
        (int)$release['user_id'] === $currentUserId
    );

    $chart[] = $release;
}

/*
 * Внешние NoLabel-плейлисты — отдельная сущность, но отображаются
 * в том же массиве рейтинга и используют те же шаблоны/классы.
 * Они не проходят через release_stats_reward_state и не влияют
 * на выплаты владельцам релизов PMD.
 */
$noLabelRows = $pdo->query('SELECT * FROM nolabel_releases ORDER BY id DESC LIMIT 500')->fetchAll(PDO::FETCH_ASSOC);
if ($noLabelRows) {
    $noLabelIds = array_map(static fn($row) => (int)$row['id'], $noLabelRows);
    $marks = implode(',', array_fill(0, count($noLabelIds), '?'));
    $snapStmt = $pdo->prepare(
        "SELECT nolabel_release_id, total_plays, captured_at
         FROM nolabel_release_snapshots
         WHERE nolabel_release_id IN ($marks)
         ORDER BY nolabel_release_id ASC, captured_at ASC, id ASC"
    );
    $snapStmt->execute($noLabelIds);
    $noLabelSnapshots = [];
    foreach ($snapStmt->fetchAll(PDO::FETCH_ASSOC) as $snap) {
        $noLabelSnapshots[(int)$snap['nolabel_release_id']][] = [
            'total' => (int)$snap['total_plays'],
            'at' => (string)$snap['captured_at'],
            'date' => substr((string)$snap['captured_at'], 0, 10),
        ];
    }

    $deltaForPeriod = static function (array $snaps, string $start, string $end): int {
        $baseline = null;
        $endValue = null;
        $firstInPeriod = null;
        foreach ($snaps as $snap) {
            if ($snap['date'] < $start) {
                $baseline = (int)$snap['total'];
                continue;
            }
            if ($snap['date'] <= $end) {
                if ($firstInPeriod === null) $firstInPeriod = (int)$snap['total'];
                $endValue = (int)$snap['total'];
            }
        }
        if ($endValue === null) return 0;
        if ($baseline === null) $baseline = $firstInPeriod ?? $endValue;
        return max(0, $endValue - $baseline);
    };

    foreach ($noLabelRows as $external) {
        $externalId = (int)$external['id'];
        $snaps = $noLabelSnapshots[$externalId] ?? [];
        $total = (int)$external['total_plays'];
        $previous = null;
        if ($period === 'all') {
            $plays = $total;
            if (count($snaps) >= 2) $previous = (int)$snaps[count($snaps) - 2]['total'];
        } else {
            $todayString = $today->format('Y-m-d');
            $plays = $deltaForPeriod($snaps, $currentStart, $todayString);
            $previousValue = $deltaForPeriod($snaps, $previousStart, $previousEnd);
            $previous = $previousValue > 0 ? $previousValue : null;
        }
        $growth = null;
        if ($previous !== null && $previous > 0) {
            $growth = (($plays - $previous) / $previous) * 100;
        }
        $artists = json_decode((string)($external['artist_names_json'] ?? '[]'), true);
        if (!is_array($artists)) $artists = [];
        $artists = array_values(array_unique(array_filter(array_map(
            static fn($name) => trim((string)$name),
            $artists
        ), static fn($name) => $name !== '')));
        $artistDisplay = $artists ? implode(', ', $artists) : 'Исполнитель';
        $chart[] = [
            'id' => -$externalId,
            'user_id' => 0,
            'title' => (string)$external['title'],
            'main_artist' => $artistDisplay,
            'artist_display' => $artistDisplay,
            'cover_path' => (string)($external['cover_url'] ?? ''),
            'chart_plays' => $plays,
            'growth' => $growth,
            'all_time_plays' => $total,
            'is_own' => false,
            'is_nolabel' => true,
            'playlist_url' => (string)$external['playlist_url'],
        ];
    }
}

usort($chart, static function (array $a, array $b): int {
    $comparison = (int)$b['chart_plays'] <=> (int)$a['chart_plays'];

    return $comparison !== 0
        ? $comparison
        : ((int)$a['id'] <=> (int)$b['id']);
});

$chart = array_slice($chart, 0, 500);

/**
 * Подготовка пути к обложке.
 *
 * Поддерживает:
 * https://site.ru/image.jpg
 * /uploads/covers/image.jpg
 * uploads/covers/image.jpg
 */
function chart_cover(?string $path): string {
    return pmd_media_url($path, 'cover');
}

/**
 * Форматирование динамики.
 */
function chart_growth(?float $growth): string {
    if ($growth === null) {
        return '—';
    }

    $prefix = $growth > 0 ? '+' : '';

    return $prefix . number_format($growth, 1, ',', ' ') . '%';
}

$pageTitle = 'Чарт релизов';

page_start($pageTitle);

