<script>
(function () {
    // Per-account NoLabel refresh: at most once every five minutes.
    fetch('nolabel-chart-refresh.php', {
        method: 'POST',
        credentials: 'same-origin',
        headers: {'Content-Type': 'application/x-www-form-urlencoded'},
        body: 'csrf_token=' + encodeURIComponent('<?=e(csrf_token())?>'),
        cache: 'no-store'
    }).catch(function (error) {
        console.warn('PMD NoLabel refresh:', error);
    });

    let stopped = false;
    let action = 'start';
    let timer = null;

    async function runChartQueue() {
        if (stopped) {
            return;
        }

        try {
            const response = await fetch('chart-refresh-worker.php', {
                method: 'POST',
                credentials: 'same-origin',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded'
                },
                body: 'action=' + encodeURIComponent(action),
                cache: 'no-store'
            });

            if (!response.ok) {
                throw new Error('HTTP ' + response.status);
            }

            const data = await response.json();

            if (!data.ok) {
                throw new Error(data.error || 'Ошибка очереди');
            }

            action = 'work';

            if (data.finished || Number(data.pending) === 0) {
                stopped = true;
                return;
            }

            timer = setTimeout(runChartQueue, 5000);

        } catch (error) {
            console.error('PMD chart refresh:', error);

            timer = setTimeout(runChartQueue, 10000);
        }
    }

    runChartQueue();

    window.addEventListener('pagehide', function () {
        stopped = true;

        if (timer !== null) {
            clearTimeout(timer);
        }
    });
})();
</script>

<?php page_end(); ?>
