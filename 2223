function upload_file(array $file, string $kind): ?string {
    if (($file['error'] ?? UPLOAD_ERR_NO_FILE) === UPLOAD_ERR_NO_FILE) {
        return null;
    }

    if (($file['error'] ?? 1) !== UPLOAD_ERR_OK) {
        throw new RuntimeException('Не удалось загрузить файл.');
    }

    $max = $kind === 'cover'
        ? 35 * 1024 * 1024
        : 100 * 1024 * 1024;

    if (($file['size'] ?? 0) > $max) {
        throw new RuntimeException('Файл превышает допустимый размер.');
    }

    $finfo = new finfo(FILEINFO_MIME_TYPE);
    $mime = $finfo->file($file['tmp_name']);

    $allowed = $kind === 'cover'
        ? ['image/jpeg' => 'jpg', 'image/png' => 'png']
        : [
            'audio/mpeg' => 'mp3',
            'audio/wav' => 'wav',
            'audio/x-wav' => 'wav',
            'audio/flac' => 'flac',
            'audio/mp4' => 'm4a',
            'audio/aac' => 'aac'
        ];

    if (!isset($allowed[$mime])) {
        throw new RuntimeException('Недопустимый формат файла.');
    }

    if ($kind === 'cover') {
        $info = @getimagesize($file['tmp_name']);

        if (!$info || $info[0] !== $info[1] || $info[0] < 3000) {
            throw new RuntimeException(
                'Обложка должна быть квадратной, не менее 3000 × 3000 px.'
            );
        }
    }

    $dir = __DIR__.'/../public/uploads/'.(
        $kind === 'cover' ? 'covers' : 'tracks'
    );

    if (!is_dir($dir)) {
        mkdir($dir, 0755, true);
    }

    $name = bin2hex(random_bytes(16)).'.'.$allowed[$mime];

    if (!move_uploaded_file($file['tmp_name'], $dir.'/'.$name)) {
        throw new RuntimeException('Не удалось сохранить файл.');
    }

    return 'uploads/'.(
        $kind === 'cover' ? 'covers' : 'tracks'
    ).'/'.$name;
}

