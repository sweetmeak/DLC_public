            $balanceQuery->execute([(int)$u['id']]);
            $balanceKopecks = (int)$balanceQuery->fetchColumn();

        } catch (Throwable $e) {
            error_log('PMD balance display error: '.$e->getMessage());
        }

        $balanceRubles = number_format(
            $balanceKopecks / 100,
            2,
            ',',
            ' '
        );

        echo '<div class="shell"><aside class="sidebar">';
        echo '<a class="brand" href="dashboard.php">';
        echo '<img src="assets/playersclub_logo.png" alt="Players Music Distribution">';
        echo '<span>PLAYERS MUSIC<br><small>DISTRIBUTION</small></span>';
        echo '</a>';

        echo '<div class="nav-caption">СООБЩЕСТВО</div>';
        echo '<nav class="pmd-nav">';
        echo pmd_nav_link('news.php', 'Новости', 'news', $currentPage);
        echo pmd_nav_link('chat.php', 'Общий чат', 'chat', $currentPage);

        echo '<div class="nav-caption nav-gap">';
        if ($role === 'admin') {
            echo 'РАБОЧЕЕ ПРОСТРАНСТВО';
        } elseif ($role === 'moderator') {
            echo 'РАБОЧЕЕ МЕСТО МОДЕРАТОРА';
        } else {
            echo 'КАБИНЕТ АРТИСТА';
        }
        echo '</div>';

        echo pmd_nav_link('dashboard.php', 'Обзор', 'dashboard', $currentPage);

        if (in_array($role, ['artist', 'curator', 'moderator', 'admin'], true)) {
            echo pmd_nav_link('statistics.php', 'Статистика', 'statistics', $currentPage);
            echo pmd_nav_link('listeners-chart.php', 'Чарт артистов', 'listeners', $currentPage);
            echo pmd_nav_link('chart.php', 'Чарт релизов', 'chart', $currentPage);
            echo pmd_nav_link('releases.php', 'Мои релизы', 'releases', $currentPage);
            echo pmd_nav_link('release-wizard.php', 'Подать релиз', 'add', $currentPage);
        }

        if (in_array($role, ['moderator', 'admin'], true)) {
            echo '<div class="nav-caption nav-gap">МОДЕРАЦИЯ</div>';
            echo pmd_nav_link('admin.php', 'Заявки на модерацию', 'moderation', $currentPage);
        }

		if ($role === 'admin') {
				echo '<div class="nav-caption nav-gap">УПРАВЛЕНИЕ</div>';
				echo pmd_nav_link('users.php', 'Пользователи и роли', 'users', $currentPage);
				echo pmd_nav_link('admin-balances.php', 'Балансы пользователей', 'finance', $currentPage);
}

        echo '<div class="nav-caption nav-gap">АККАУНТ</div>';
        echo pmd_nav_link('profile.php', 'Профиль', 'profile', $currentPage);
        echo pmd_nav_link('finance.php', 'Финансы', 'finance', $currentPage);
        echo '</nav>';

        echo '<div class="sidebar-bottom">';
        echo '<span>'.e($roleLabels[$role] ?? 'Пользователь').'</span>';
        echo '<b>'.e($u['login']).'</b>';
        echo '<a href="logout.php">'.
            pmd_nav_icon('logout').
            '<span>Выйти из аккаунта</span>'.
            '</a>';
        echo '</div></aside><main class="main">';

        echo '<header class="topbar">';
        echo '<div class="crumb">PMD <i>/</i> '.
            e(strtoupper($roleLabels[$role] ?? 'PORTAL')).
            '</div>';

        echo '<div class="user-chip">';

        $avatarPath = (string)($u['avatar_path'] ?? '');
        $avatarUrl = '';

        if (
            $avatarPath !== '' &&
            preg_match(
                '/^uploads\/avatars\/avatar_[0-9]+_[a-f0-9]{24}\.webp$/',
                $avatarPath
            )
        ) {
            $avatarFullPath = __DIR__.'/../public/'.$avatarPath;

            if (is_file($avatarFullPath)) {
                $avatarUrl = $avatarPath.'?v='.filemtime($avatarFullPath);
            }
        }

        if ($avatarUrl !== '') {
            echo '<span class="avatar"><img src="'.e($avatarUrl).'" alt="Аватар"></span>';
        } else {
            echo '<span class="avatar">'.
                e(mb_strtoupper(mb_substr((string)$u['login'], 0, 1, 'UTF-8'), 'UTF-8')).
                '</span>';
        }

        echo e((string)$u['login']);
        echo '<span class="muted">· '.
            e($roleLabels[$role] ?? $role).
            '</span>';

        // Баланс рядом с аватаром и логином.
        echo '<span class="pmd-balance" title="Ваш текущий баланс">';
        echo '<span class="pmd-balance-icon">₽</span>';
        echo '<span class="pmd-balance-value">'.e($balanceRubles).' ₽</span>';
        echo '</span>';

        echo '</div></header>';

        if ($currentPage !== 'dashboard.php') {
            require __DIR__.'/notifications-widget.php';
        }

    } else {
        echo '<main class="auth-wrap">';
    }
}

function page_end(): void {
    $currentPage = basename($_SERVER['SCRIPT_NAME'] ?? '');
    $isPublicChart = !current_user() && $currentPage === 'chart.php';

    if (current_user() || $isPublicChart) {
        echo '</main></div>';
    } else {
        echo '</main>';
    }

    echo '<script src="assets/app.js"></script></body></html>';
}
