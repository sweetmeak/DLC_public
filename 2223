<script>
(function () {
    const queue = Array.from(
        document.querySelectorAll('.pmd-achievement-overlay')
    );

    if (!queue.length) return;
    if (window.pmdAchievementQueueRunning) return;

    window.pmdAchievementQueueRunning = true;

    let index = 0;
    let closing = false;
    let autoCloseTimer = null;
    let audioContext = null;

    function playAchievementSound(rarity) {
        try {
            const AudioContextClass =
                window.AudioContext || window.webkitAudioContext;

            if (!AudioContextClass) return;

            if (!audioContext) {
                audioContext = new AudioContextClass();
            }

            if (audioContext.state === 'suspended') {
                audioContext.resume().catch(function () {});
            }

            const notes = rarity === 'legendary'
                ? [392, 523, 659, 784, 1046]
                : rarity === 'rare'
                    ? [440, 554, 659, 880]
                    : [523, 659, 784];

            const startAt = audioContext.currentTime;

            notes.forEach(function (frequency, noteIndex) {
                const start = startAt + noteIndex * 0.13;
                const oscillator = audioContext.createOscillator();
                const gain = audioContext.createGain();

                oscillator.type = rarity === 'legendary'
                    ? 'triangle'
                    : 'sine';

                oscillator.frequency.setValueAtTime(frequency, start);
                gain.gain.setValueAtTime(0.0001, start);
                gain.gain.exponentialRampToValueAtTime(
                    rarity === 'legendary' ? 0.12 : 0.075,
                    start + 0.025
                );
                gain.gain.exponentialRampToValueAtTime(
                    0.0001,
                    start + 0.42
                );

                oscillator.connect(gain);
                gain.connect(audioContext.destination);
                oscillator.start(start);
                oscillator.stop(start + 0.45);
            });
        } catch (error) {
            // Звук может быть запрещён браузером.
        }
    }

    function showNext() {
        if (closing) return;

        while (
            index < queue.length &&
            !document.body.contains(queue[index])
        ) {
            index++;
        }

        if (index >= queue.length) {
            window.pmdAchievementQueueRunning = false;
            return;
        }

        const overlay = queue[index];
        const button = overlay.querySelector('.pmd-achievement-close');

        overlay.setAttribute('aria-hidden', 'false');
        overlay.classList.add('active');

        playAchievementSound(overlay.dataset.rarity || 'ordinary');

        let handled = false;

        function closeCurrent() {
            if (handled || closing) return;

            handled = true;
            closing = true;

            if (autoCloseTimer !== null) {
                window.clearTimeout(autoCloseTimer);
                autoCloseTimer = null;
            }

            overlay.classList.remove('active');
            overlay.setAttribute('aria-hidden', 'true');

            window.setTimeout(function () {
                document.removeEventListener('keydown', onKeyDown);
                overlay.remove();
                index++;
                closing = false;
                window.setTimeout(showNext, 350);
            }, 700);
        }

        if (button) {
            button.addEventListener('click', function (event) {
                event.preventDefault();
                event.stopPropagation();
                closeCurrent();
            }, { once: true });
        }

        overlay.addEventListener('click', function (event) {
            if (event.target === overlay) {
                closeCurrent();
            }
        });

        function onKeyDown(event) {
            if (event.key === 'Escape' && document.body.contains(overlay)) {
                closeCurrent();
            }
        }

        document.addEventListener('keydown', onKeyDown);

        autoCloseTimer = window.setTimeout(closeCurrent, 15000);
    }

    window.setTimeout(showNext, 450);
})();
</script>
HTML;
}

function require_auth(): void {
    $u = current_user();

    if (!$u) {
        go('login.php');
    }

    $q = db()->prepare(
        'SELECT id,status,role,login,email,avatar_path
         FROM users
         WHERE id=?
         LIMIT 1'
    );

    $q->execute([(int)($u['id'] ?? 0)]);
    $fresh = $q->fetch(PDO::FETCH_ASSOC);

    if (!$fresh || $fresh['status'] !== 'active') {
        unset($_SESSION['user']);
        session_regenerate_id(true);
        flash('error', 'Сессия аккаунта устарела. Войдите заново.');
        go('login.php');
    }

    $_SESSION['user'] = [
        'id' => (int)$fresh['id'],
        'login' => $fresh['login'],
        'email' => $fresh['email'],
        'role' => $fresh['role'],
        'avatar_path' => $fresh['avatar_path'] ?? null
    ];

    if ($fresh['role'] === 'artist') {
        pmd_check_user_achievements((int)$fresh['id']);
    }

    if ($fresh['role'] === 'artist') {
        $currentPage = basename($_SERVER['SCRIPT_NAME'] ?? '');

        $allowedPages = [
            'profile.php',
            'profile-save.php',
            'logout.php'
        ];

        if (!in_array($currentPage, $allowedPages, true)) {
            if (!pmd_artist_payment_complete((int)$fresh['id'])) {
                go('profile.php?complete=1');
            }
        }
    }

    pmd_schedule_user_vk_sync((int)$fresh['id']);
}

