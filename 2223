function e(?string $s): string {
    return htmlspecialchars($s ?? '', ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');
}

function csrf_token(): string {
    return $_SESSION['csrf'] ??= bin2hex(random_bytes(32));
}

function verify_csrf(): void {
    if (
        !is_string($_POST['csrf_token'] ?? null) ||
        !hash_equals($_SESSION['csrf'] ?? '', $_POST['csrf_token'])
    ) {
        http_response_code(419);
        exit('Сессия истекла. Обновите страницу.');
    }
}

function current_user(): ?array {
    return $_SESSION['user'] ?? null;
}

/**
 * Проверяет заполнение обязательных платёжных данных артиста.
 */
function pmd_artist_payment_complete(int $userId): bool {
    $q = db()->prepare(
        'SELECT
            full_name,
            phone,
            bank_name,
            inn,
            card_number_encrypted
         FROM artist_profiles
         WHERE user_id = ?
         LIMIT 1'
    );

    $q->execute([$userId]);
    $p = $q->fetch(PDO::FETCH_ASSOC);

    if (!$p) {
        return false;
    }

    return
        trim((string)($p['full_name'] ?? '')) !== '' &&
        preg_match('/^\+7\d{10}$/', (string)($p['phone'] ?? '')) === 1 &&
        trim((string)($p['bank_name'] ?? '')) !== '' &&
        preg_match('/^\d{12}$/', (string)($p['inn'] ?? '')) === 1 &&
        !empty($p['card_number_encrypted']);
}

/**
 * Определяет редкость достижения по его коду.
 */
function pmd_achievement_rarity(string $code): string {
    if ($code === 'players_club_welcome') {
        return 'legendary';
    }

    $rareCodes = [
        'ten_thousand_plays',
        'hundred_thousand_plays',
        'chart_first_place',
    ];

    return in_array($code, $rareCodes, true) ? 'rare' : 'ordinary';
}

/**
 * Проверяет достижения и складывает новые награды в очередь сессии.
 */
function pmd_check_user_achievements(int $userId): void {
    if ($userId <= 0) {
        return;
    }

    require_once __DIR__.'/achievements.php';

    if (!function_exists('pmd_sync_achievements')) {
        return;
    }

    try {
        $result = pmd_sync_achievements(db(), $userId);
        $newlyEarned = $result['newly_earned'] ?? [];

        if (!$newlyEarned) {
            return;
        }

        if (
            !isset($_SESSION['pmd_achievement_notifications']) ||
            !is_array($_SESSION['pmd_achievement_notifications'])
        ) {
            $_SESSION['pmd_achievement_notifications'] = [];
        }

        foreach ($newlyEarned as $achievement) {
            $code = (string)($achievement['code'] ?? '');

            if ($code === '') {
                continue;
            }

            $alreadyQueued = false;

            foreach ($_SESSION['pmd_achievement_notifications'] as $queued) {
                if (($queued['code'] ?? '') === $code) {
                    $alreadyQueued = true;
                    break;
                }
            }

            if ($alreadyQueued) {
                continue;
            }

            $_SESSION['pmd_achievement_notifications'][] = [
                'code' => $code,
                'title' => (string)($achievement['title'] ?? 'Новое достижение'),
                'description' => (string)($achievement['description'] ?? ''),
                'icon' => (string)($achievement['icon'] ?? 'trophy'),
                'accent' => (string)($achievement['accent'] ?? 'lime'),
                'rarity' => pmd_achievement_rarity($code),
            ];
        }

        $_SESSION['pmd_achievement_notifications'] = array_slice(
            $_SESSION['pmd_achievement_notifications'],
            -20
        );

    } catch (Throwable $e) {
        error_log('PMD achievements error: '.$e->getMessage());
    }
}

